# Copy to .env and fill in. Never commit .env.
# Free-tier LLM key (Groq or Gemini); added in the generation phase.
LLM_API_KEY=
# OpenAI-compatible chat endpoint used by goldgen (default: Groq).
# Alternative, Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Model name for that endpoint (Gemini example: gemini-2.0-flash).
# LLM_MODEL=openai/gpt-oss-120b
